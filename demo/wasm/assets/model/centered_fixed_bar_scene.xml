          body2="left_wrist_yaw_link"
          relpose="-0.098225715 0.148661419 -0.028767218 0.707127478 -0.707086077 0.000087163 -0.000048312"
          solref="0.002 1" solimp="0.99 0.999 0.0001"/>
    <connect name="right_bar_fixed_link" site1="right_bar_attachment"
